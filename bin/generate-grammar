#!/usr/bin/env python3
"""Generate the grammar summary from the Korean language reference."""

from pathlib import Path
import argparse
import sys

CATALOG = Path(__file__).resolve().parent.parent / "TSPLK.docc"
CHAPTERS = [
    ("LexicalStructure", "어휘 구조 (Lexical Structure)"),
    ("Types", "타입 (Types)"),
    ("Expressions", "표현식 (Expressions)"),
    ("Statements", "구문 (Statements)"),
    ("Declarations", "선언 (Declarations)"),
    ("Attributes", "속성 (Attributes)"),
    ("Patterns", "패턴 (Patterns)"),
    ("GenericParametersAndArguments", "제네릭 매개변수와 인자 (Generic Parameters and Arguments)"),
]


def grammar_blocks(text):
    blocks = []
    current = None
    in_comment = False
    for line in text.splitlines():
        if "<!--" in line:
            in_comment = True
        if in_comment:
            if "-->" in line:
                in_comment = False
            continue
        if line.startswith("> Grammar of "):
            current = []
        if current is not None:
            if line.startswith(">"):
                current.append(line.rstrip())
            else:
                blocks.append("\n".join(current))
                current = None
    if current is not None:
        blocks.append("\n".join(current))
    return blocks


def generate():
    sections = [
        "# 문법 요약 (Summary of the Grammar)\n\n전체 공식 문법을 읽어보세요.",
        "<!-- Generated by bin/generate-grammar. Edit the reference chapters, then regenerate this file. -->",
    ]
    for chapter, title in CHAPTERS:
        source = (CATALOG / "ReferenceManual" / f"{chapter}.md").read_text(encoding="utf-8")
        blocks = grammar_blocks(source)
        if not blocks:
            raise ValueError(f"No grammar blocks found in {chapter}")
        sections.append("## " + title)
        sections.extend(blocks)
    sections.append(
        "<!--\n"
        "This source file is part of the Swift.org open source project\n\n"
        "Copyright (c) 2014 - 2022 Apple Inc. and the Swift project authors\n"
        "Licensed under Apache License v2.0 with Runtime Library Exception\n\n"
        "See https://swift.org/LICENSE.txt for license information\n"
        "See https://swift.org/CONTRIBUTORS.txt for the list of Swift project authors\n"
        "-->"
    )
    return "\n\n".join(sections) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check the committed summary without changing it")
    args = parser.parse_args()
    target = CATALOG / "ReferenceManual" / "SummaryOfTheGrammar.md"
    expected = generate()
    if args.check:
        if not target.exists() or target.read_text(encoding="utf-8") != expected:
            print("Grammar summary is out of date. Run python3 bin/generate-grammar.", file=sys.stderr)
            return 1
        print("Grammar summary matches the reference chapters.")
    else:
        target.write_text(expected, encoding="utf-8")
        print("Generated TSPLK.docc/ReferenceManual/SummaryOfTheGrammar.md")
    return 0


if __name__ == "__main__":
    sys.exit(main())
